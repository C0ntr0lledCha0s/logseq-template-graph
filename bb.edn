{:paths ["src" "test"]
 :tasks
 {build
  {:doc "Build build/schema-library.edn and build/schema-presets.edn"
   :requires ([template-graph.edn-io])
   :task (load-file "scripts/build.clj")}
  validate
  {:doc "Validate build/ output against Schema.org"
   :depends [build]
   :requires ([template-graph.edn-io])
   :task (load-file "scripts/validate.clj")}
  check-import
  {:doc "Import build/schema-library.edn into a fresh Logseq graph (needs LOGSEQ_DIR)"
   :depends [build]
   :requires ([clojure.string :as str] [babashka.fs :as fs] [babashka.process :as p])
   :task (let [logseq-dir (System/getenv "LOGSEQ_DIR")
               _ (when (str/blank? logseq-dir)
                   (println "LOGSEQ_DIR must point at a logseq/logseq checkout") (System/exit 1))
               nbb (str logseq-dir "/scripts/node_modules/.bin/nbb-logseq")
               _ (when-not (fs/exists? nbb)
                   (println "Missing" nbb "- run `pnpm install --ignore-workspace` in" (str logseq-dir "/scripts")) (System/exit 1))
               out (fs/create-dirs ".check-import")]
           (spit (str out "/nbb.edn")
                 (str/replace (slurp "scripts/ci/nbb.edn.template") "${LOGSEQ_DIR}" (str (fs/canonicalize logseq-dir))))
           (fs/copy "scripts/ci/check-import.cljs" (str out "/check_import.cljs") {:replace-existing true})
           (fs/delete-if-exists (str out "/node_modules"))
           (fs/create-sym-link (str out "/node_modules") (str (fs/canonicalize (str logseq-dir "/scripts/node_modules"))))
           (let [{:keys [exit]} (p/shell {:continue true}
                                         (str (fs/canonicalize nbb)) (str out "/check_import.cljs")
                                         (str (fs/canonicalize "build/schema-library.edn")))]
             (System/exit exit)))}
  publish-library
  {:doc "Copy build/ output into the committed library/ directory"
   :depends [build]
   :requires ([babashka.fs :as fs])
   :task (do (fs/create-dirs "library")
             (doseq [f ["schema-library.edn" "schema-presets.edn"]]
               (fs/copy (str "build/" f) (str "library/" f) {:replace-existing true})))}
  check-library
  {:doc "Fail if library/ differs from build/"
   :depends [build]
   :requires ([babashka.fs :as fs])
   :task (when-not (every? (fn [f] (and (fs/exists? (str "library/" f))
                                        (= (slurp (str "build/" f)) (slurp (str "library/" f)))))
                           ["schema-library.edn" "schema-presets.edn"])
           (println "library/ is out of date — run bb publish-library and commit")
           (System/exit 1))}
  test
  {:doc "Run template-graph unit tests"
   :requires ([template-graph.run-tests :as run-tests])
   :task (run-tests/-main)}}}
