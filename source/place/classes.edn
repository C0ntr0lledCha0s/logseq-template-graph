{:classes
 {:schema.class/VirtualLocation
  {:block/title "VirtualLocation",
   :build/class-extends [:schema.class/Intangible],
   :build/properties
   {:logseq.property/icon {:id "desktop_computer", :type :emoji},
    :logseq.property/description
    "An online or virtual location for attending events. For example, one may attend an online seminar or educational event. While a virtual location may be used as the location of an event, virtual locations should not be confused with physical locations in the real world.",
    :schema.property/url "https://schema.org/VirtualLocation"}},
  :schema.class/Country
